# copy to .env and fill in. generate secrets with: openssl rand -hex 24
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

N8N_DB_PASSWORD=change-me
APP_DB_PASSWORD=change-me
GRAFANA_DB_PASSWORD=change-me

# never change this after first run or n8n can't decrypt saved credentials
N8N_ENCRYPTION_KEY=change-me

# set to your tunnel URL (cloudflared/ngrok) when Freshdesk/Zendesk needs to reach the webhook
WEBHOOK_URL=http://localhost:5678/

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
