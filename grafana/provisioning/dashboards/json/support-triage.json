{
  "uid": "support-triage",
  "title": "AI Support Triage",
  "tags": [
    "support",
    "ai"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Tickets",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "support-db"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "support-db"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT count(*) AS tickets FROM tickets t WHERE $__timeFilter(t.received_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Auto-drafted",
      "description": "Share of tickets routed to draft review instead of the human queue",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "support-db"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "support-db"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT round(100.0 * avg((d.routed_to = 'draft_review')::int), 1) AS pct FROM drafts d JOIN tickets t ON t.id = d.ticket_id WHERE $__timeFilter(t.received_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Minutes saved",
      "description": "Approved drafts only. Baseline minutes per category are assumptions in handling_baselines",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "support-db"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "support-db"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT coalesce(sum(minutes_saved), 0) AS minutes FROM v_time_saved WHERE $__timeFilter(received_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Draft edit rate",
      "description": "Approved drafts the agent changed before sending",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "support-db"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "support-db"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT round(100.0 * avg(d.was_edited::int), 1) AS pct FROM drafts d JOIN tickets t ON t.id = d.ticket_id WHERE d.review_status = 'approved' AND $__timeFilter(t.received_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Median pipeline time",
      "description": "Ticket received to draft saved",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "support-db"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "support-db"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT round((percentile_cont(0.5) WITHIN GROUP (ORDER BY total) / 1000.0)::numeric, 1) AS seconds FROM (SELECT ticket_id, sum(duration_ms) AS total FROM pipeline_steps WHERE $__timeFilter(started_at) GROUP BY ticket_id) x"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Tokens per ticket",
      "description": "Classify + draft, input and output",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "support-db"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "support-db"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT round(avg(total)) AS tokens FROM (SELECT ticket_id, sum((meta->>'input_tokens')::int + (meta->>'output_tokens')::int) AS total FROM pipeline_steps WHERE meta ? 'input_tokens' AND $__timeFilter(started_at) GROUP BY ticket_id) x"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 7,
      "type": "barchart",
      "title": "Tickets by category",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "support-db"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "support-db"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT coalesce(c.category, 'invalid') AS category, count(*) AS tickets FROM tickets t JOIN LATERAL (SELECT category FROM classifications WHERE ticket_id = t.id ORDER BY created_at DESC LIMIT 1) c ON true WHERE $__timeFilter(t.received_at) GROUP BY 1 ORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xField": "category",
        "showValue": "auto",
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "barWidth": 0.7,
        "groupWidth": 0.7,
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "type": "barchart",
      "title": "Why tickets went where they did",
      "description": "model_unsure = the drafter found no KB article that covers the issue",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "support-db"
      },
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "support-db"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT d.routing_reason AS reason, count(*) AS tickets FROM drafts d JOIN tickets t ON t.id = d.ticket_id WHERE $__timeFilter(t.received_at) GROUP BY 1 ORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xField": "reason",
        "showValue": "auto",
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "barWidth": 0.7,
        "groupWidth": 0.7,
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "type": "barchart",
      "title": "Step latency",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "support-db"
      },
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "support-db"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT step, round(avg(duration_ms)) AS avg_ms, round((percentile_cont(0.95) WITHIN GROUP (ORDER BY duration_ms))::numeric) AS p95_ms FROM pipeline_steps WHERE $__timeFilter(started_at) GROUP BY step ORDER BY min(id)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xField": "step",
        "showValue": "auto",
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "barWidth": 0.7,
        "groupWidth": 0.7,
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Eval accuracy by prompt version",
      "description": "Labelled set of 36 tickets. Not filtered by time range",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "support-db"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "support-db"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT prompt_version AS \"Prompt\", model AS \"Model\", cases AS \"Cases\", round(category_acc * 100, 1) AS \"Category %\", round(priority_acc * 100, 1) AS \"Priority %\", round(valid_json_rate * 100, 1) AS \"Valid JSON %\", notes AS \"Change\" FROM v_eval_accuracy ORDER BY run_id"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 11,
      "type": "table",
      "title": "Human queue (oldest first)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "support-db"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "support-db"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT t.id AS \"Ticket\", t.account_name AS \"Account\", left(t.subject, 45) AS \"Subject\", d.routing_reason AS \"Reason\", round(extract(epoch FROM now() - t.received_at) / 60) AS \"Waiting (min)\" FROM drafts d JOIN tickets t ON t.id = d.ticket_id WHERE d.routed_to = 'human_queue' AND d.review_status = 'pending' AND $__timeFilter(t.received_at) ORDER BY t.received_at LIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}