      "parameters": {
        "operation": "executeQuery",
        "query": "WITH d AS (\n  UPDATE drafts\n  SET review_status = CASE WHEN $2 = 'approve' THEN 'approved' ELSE 'rejected' END,\n      final_body    = CASE WHEN $2 = 'approve' THEN coalesce(nullif($3, ''), draft_body) END,\n      reviewed_by   = $4,\n      reviewed_at   = now()\n  WHERE id = $1\n    AND review_status = 'pending'\n    AND $2 IN ('approve', 'reject')\n  RETURNING id, ticket_id, review_status, was_edited\n)\nUPDATE tickets t\nSET status = CASE WHEN d.review_status = 'approved' THEN 'approved' ELSE 'human_queue' END,\n    updated_at = now()\nFROM d WHERE t.id = d.ticket_id\nRETURNING d.*;",
        "options": {
          "queryReplacement": "={{ [ $json.body.draft_id, $json.body.action, $json.body.final_body ?? '', $json.body.reviewed_by ?? 'agent' ] }}"
